---
interface Props {
    title: string;
    url: string;
    tags: string[];
    slug: string;
    icon?: string;
    excerpt?: string;
}

const { title, url, slug, excerpt, tags, icon } = Astro.props as Props;
---

<article
    class="group flex h-full gap-4 rounded-xl border border-zinc-700/80 bg-zinc-800/75 p-4 transition hover:-translate-y-0.5 hover:border-emerald-500/50 hover:bg-zinc-800"
    transition:name={`project-card-${slug}`}
>
    {
        icon && (
            <div
                class="flex size-12 shrink-0 items-center justify-center text-emerald-500 [&_img]:max-h-12 [&_img]:max-w-12 [&_svg]:max-h-12 [&_svg]:max-w-12"
                set:html={icon}
                transition:name={`project-icon-${slug}`}
            />
        )
    }

    <div class="flex min-w-0 flex-1 flex-col">
        <h3
            class="font-serif text-lg font-bold leading-snug"
            transition:name={`project-title-${slug}`}
        >
            <a
                href={`/project/${slug}/`}
                class="text-blue-300 hover:underline"
            >
                {title}
            </a>
        </h3>

        {
            excerpt && (
                <p class="mt-1 text-sm leading-relaxed text-zinc-300">
                    {excerpt}
                </p>
            )
        }

        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-3">
            <p class="text-xs text-zinc-500">{tags.slice(0, 3).join(" · ")}</p>
            <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open ${title} app in a new tab`}
                class="rounded-md border border-emerald-500/50 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-bold text-emerald-300 transition hover:border-emerald-400 hover:bg-emerald-500/20"
            >
                Open app <span aria-hidden="true">&nearr;</span>
            </a>
        </div>
    </div>
</article>
