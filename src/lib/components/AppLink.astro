---
import Icon from "../partials/Icon.svelte";

interface Props {
    url: string;
    label?: string;
}

const { url, label = "Open app" } = Astro.props as Props;
---

<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="not-prose inline-flex items-center justify-center gap-2 rounded-md border border-emerald-500/50 bg-emerald-500/10 px-4 py-2.5 font-bold text-emerald-300 transition hover:border-emerald-400 hover:bg-emerald-500/20"
>
    {label}
    <Icon icon="ext-link" class="size-4" />
</a>
