---
import { getCollection } from "astro:content";

import Base from "$layout/Base.astro";
import Date from "$part/Date.astro";
import Project from "$part/Project.astro";
import Section from "$part/Section.astro";
import Social from "$part/Social.svelte";
import { config } from "$util/config";

const projects = await getCollection("projects");

const posts = (
    await getCollection("blog", ({ data }) => data.draft !== true)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const latestPost = posts[0];
const recentPosts = posts.slice(1, 4);
---

<Base head={{ title: config.title, description: config.description }}>
    <!-- Introduction and featured post -->
    <Section>
        <div
            class="grid items-stretch gap-6 py-4 lg:grid-cols-12 lg:gap-8 lg:py-10"
        >
            <div class="flex flex-col justify-center lg:col-span-5">
                <h1
                    class="font-serif text-4xl font-bold leading-tight sm:text-5xl"
                >
                    Small apps and useful notes for easier tabletop games.
                </h1>

                <p class="mt-5 text-lg leading-relaxed text-zinc-300">
                    Hi, I’m <strong class="text-emerald-400">Colin</strong>. I
                    make small apps, collect game resources, and write about
                    organizing, running, and playing tabletop role-playing games.
                </p>

                <div class="mt-7 flex flex-wrap items-center gap-3">
                    <a
                        href="/resources"
                        class="rounded-md border border-zinc-600 px-4 py-2.5 text-blue-300 transition hover:border-blue-300 hover:bg-zinc-800"
                    >
                        Browse resources
                    </a>

                    <div class="ml-1 flex gap-2">
                        <Social
                            icon="discord"
                            colors="bg-discord text-white"
                            href="https://discord.gg/KFsS85zd5B"
                        />
                        <Social
                            icon="github"
                            colors="bg-white text-black"
                            href="https://github.com/ttrpgtools/"
                        />
                    </div>
                </div>
            </div>

            <article
                class="group relative min-h-96 overflow-hidden rounded-2xl border border-zinc-700 bg-zinc-800 shadow-2xl shadow-black/20 lg:col-span-7"
            >
                <img
                    src={latestPost.data.banner.src}
                    alt={latestPost.data.banner.alt}
                    style={{
                        objectPosition:
                            latestPost.data.banner.position || "center",
                    }}
                    class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                />

                <div
                    class="absolute inset-0 bg-linear-to-t from-zinc-950 via-zinc-950/45 to-transparent"
                >
                </div>

                <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
                    <p
                        class="mb-3 inline-flex rounded-full bg-emerald-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-zinc-950"
                    >
                        Latest post
                    </p>

                    <h2
                        class="max-w-xl font-serif text-3xl font-bold sm:text-4xl"
                    >
                        <a
                            href={`/post/${latestPost.id}/`}
                            class="decoration-emerald-400 decoration-2 underline-offset-4 hover:underline"
                            transition:name={`post-title-${latestPost.id}`}
                        >
                            {latestPost.data.title}
                        </a>
                    </h2>

                    <p class="mt-3 max-w-2xl text-zinc-200">
                        {latestPost.data.excerpt}
                    </p>

                    <p class="mt-3 text-sm text-zinc-400">
                        <Date date={latestPost.data.date} /> · {
                            latestPost.data.tags.join(" · ")
                        }
                    </p>
                </div>
            </article>
        </div>
    </Section>

    <!-- Project collection -->
    <Section>
        <div class="mb-5 flex items-end justify-between gap-4">
            <h2 class="font-serif text-3xl font-bold">Tools for the table</h2>
            <a class="text-sm text-blue-300 hover:underline" href="/projects">
                All projects &rarr;
            </a>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
            {
                projects.map((project) => (
                    <Project
                        title={project.data.title}
                        url={project.data.url}
                        slug={project.id}
                        excerpt={project.data.excerpt}
                        tags={project.data.tags}
                        icon={project.data.icon}
                    />
                ))
            }
        </div>
    </Section>

    <!-- Recent writing -->
    <Section>
        <div class="rounded-2xl bg-zinc-800/55 p-5 sm:p-7">
            <div class="mb-5 flex items-center justify-between gap-4">
                <h2 class="font-serif text-2xl font-bold">
                    More from the blog
                </h2>
                <a class="text-sm text-blue-300 hover:underline" href="/posts">
                    All posts &rarr;
                </a>
            </div>

            <div class="grid gap-5 md:grid-cols-3">
                {
                    recentPosts.map((post) => (
                        <article class="border-l-2 border-zinc-700 pl-4 hover:border-emerald-500">
                            <p class="text-xs text-zinc-400">
                                <Date date={post.data.date} />
                            </p>
                            <h3 class="mt-2 font-serif text-lg font-bold leading-snug">
                                <a
                                    class="text-blue-300 hover:underline"
                                    href={`/post/${post.id}/`}
                                    transition:name={`post-title-${post.id}`}
                                >
                                    {post.data.title}
                                </a>
                            </h3>
                            <p class="mt-2 text-sm text-zinc-300">
                                {post.data.excerpt}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </Section>
</Base>
