---
import { getCollection } from "astro:content";

import Base from "$layout/Base.astro";
import Project from "$part/Project.astro";
import Section from "$part/Section.astro";

const projects = await getCollection("projects");
---

<Base
    head={{
        title: "Projects",
        description: "A list of projects from TTRPG.tools",
    }}
>
    <Section>
        <h1 class="mb-4 font-serif text-3xl font-bold">Projects</h1>

        <div class="flex flex-col gap-4">
            {
                projects.map((project) => (
                    <Project
                        title={project.data.title}
                        url={project.data.url}
                        slug={project.id}
                        excerpt={project.data.excerpt}
                        tags={project.data.tags}
                        icon={project.data.icon}
                    />
                ))
            }
        </div>
    </Section>
</Base>
